# Base URL of the NestJS API. Must be an exact origin with no trailing slash.
# Local:      http://localhost:4000
# Production: https://api.akwannya-hub.org
NEXT_PUBLIC_API_URL=http://localhost:4000

# Renders the "Continue with Google" button on the very first paint instead of
# after a round trip. The API's /auth/providers remains authoritative and will
# correct a wrong value within one request, so this is a hint, not a switch.
# Set to "true" only where the API actually has Google credentials.
NEXT_PUBLIC_GOOGLE_SIGN_IN=false
