NODE_ENV=development
PORT=4000

WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# DEVELOPMENT: local Postgres. This is the recommended default — a hosted free
# tier that suspends idle compute will raise Prisma P1001 on the next query after
# a short pause, which makes local development miserable.
DATABASE_URL="postgresql://<you>@localhost:5432/faceoff_dev?schema=public"
DIRECT_URL="postgresql://<you>@localhost:5432/faceoff_dev?schema=public"

# PRODUCTION (Neon or any pooled Postgres): DATABASE_URL is used at runtime,
# DIRECT_URL only by `prisma migrate`. On Neon these are two hosts for one
# database:
#   DATABASE_URL -> POOLED endpoint (host contains "-pooler") plus
#                   ?pgbouncer=true&connection_limit=10
#   DIRECT_URL   -> DIRECT endpoint (same host without "-pooler")
# PgBouncer runs in transaction mode and cannot hold the session state that DDL,
# advisory locks and migration transactions need, so migrations must bypass it.
# connection_limit=1 is Prisma's guidance for SERVERLESS deployments only; this
# API is one long-running process, so a pool of 1 serialises concurrent queries
# and any endpoint issuing parallel reads times out with P2024.

REDIS_URL=redis://localhost:6380

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-value-abcdefgh
JWT_REFRESH_SECRET=replace-me-with-a-different-48-byte-random-value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Leave COOKIE_DOMAIN unset locally. In production set .akwannya-hub.org so the
# cookie is shared between devarena. and api. subdomains.
COOKIE_DOMAIN=
COOKIE_SECURE=false

BCRYPT_ROUNDS=12

# Development convenience: treats every account as verified and skips the
# verification email. The env schema REFUSES this when NODE_ENV=production.
AUTH_SKIP_EMAIL_VERIFICATION=false

# For local development, tunnel the EC2 instance's Judge0 to this machine:
#   ssh -N -L 2358:localhost:2358 <user>@<ec2-host>
# then use the instance's AUTHN_TOKEN as JUDGE0_TOKEN.
JUDGE0_URL=http://localhost:2358
JUDGE0_TOKEN=replace-me

# "console" prints emails to the terminal and never delivers them. "resend"
# sends for real. The schema REFUSES console when NODE_ENV=production.
MAIL_DRIVER=console

# Create at resend.com/api-keys. "Sending access" is enough.
#
# Store the BARE key. The mail service adds the "Bearer " scheme itself, and the
# schema refuses a value that does not start with "re_" so a key pasted from the
# wrong place fails at boot rather than silently 401-ing on every send.
RESEND_API_KEY=

# Must be on a domain verified in Resend, or the send is rejected with a 403 and
# the body "domain is not verified".
#
# BEFORE YOUR DOMAIN VERIFIES: Resend provides a test sender for onboarding
# (onboarding@resend.dev) which can usually only deliver to the email address
# the Resend account was registered with. Check your dashboard for the exact
# address and limits. Enough to prove the wiring end to end in development.
RESEND_FROM_ADDRESS=
RESEND_FROM_NAME=Software Engineering Face-Off

# ── Google sign-in (optional) ────────────────────────────────────────────────
# All three together, or none. Leave unset and the provider is simply off:
# GET /api/auth/providers reports it, the button never renders, and the flow
# routes 404 — so this ships safely before the credentials exist.
#
# GOOGLE_REDIRECT_URI must byte-match an Authorised redirect URI in the Google
# console, and it is the API host with the /api prefix, not the web app:
#   production  https://api.akwannya-hub.org/api/auth/google/callback
#   local       http://localhost:4000/api/auth/google/callback
#
# See GOOGLE_SIGN_IN.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
