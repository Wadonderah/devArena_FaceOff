NODE_ENV=development
PORT=4000

WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# DATABASE_URL is used at runtime; DIRECT_URL is used only by `prisma migrate`.
# On Neon these are two different hosts for the same database:
#   DATABASE_URL -> the POOLED endpoint (host contains "-pooler"), plus
#                   ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   -> the DIRECT endpoint (same host without "-pooler")
# PgBouncer runs in transaction mode and cannot hold the session state that DDL,
# advisory locks and migration transactions require, so migrations must bypass it.
# With a plain Postgres (no pooler), set both to the same value.
DATABASE_URL=postgresql://faceoff:faceoff@localhost:5433/faceoff?schema=public
DIRECT_URL=postgresql://faceoff:faceoff@localhost:5433/faceoff?schema=public

REDIS_URL=redis://localhost:6380

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-a-48-byte-random-value-abcdefgh
JWT_REFRESH_SECRET=replace-me-with-a-different-48-byte-random-value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Leave COOKIE_DOMAIN unset locally. In production set .akwannya-hub.org so the
# cookie is shared between devarena. and api. subdomains.
COOKIE_DOMAIN=
COOKIE_SECURE=false

BCRYPT_ROUNDS=12

# Development convenience: treats every account as verified and skips the
# verification email. The env schema REFUSES this when NODE_ENV=production.
AUTH_SKIP_EMAIL_VERIFICATION=false

# For local development, tunnel the EC2 instance's Judge0 to this machine:
#   ssh -N -L 2358:localhost:2358 <user>@<ec2-host>
# then use the instance's AUTHN_TOKEN as JUDGE0_TOKEN.
JUDGE0_URL=http://localhost:2358
JUDGE0_TOKEN=replace-me

MAIL_DRIVER=console
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM_ADDRESS=
ZEPTOMAIL_FROM_NAME=Software Engineering Face-Off
