generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PARTICIPANT
  ORGANIZER
  SUPER_ADMIN
}

enum CompetitionState {
  DRAFT
  REGISTRATION
  LIVE
  COMPLETED
  ARCHIVED
}

enum RoundState {
  DRAFT
  SCHEDULED
  LIVE
  PAUSED
  COMPLETED
  FINALIZED
  ARCHIVED
}

enum RevealMode {
  IMMEDIATE
  ON_ROUND_END
  NEVER
}

/// How a round attributes score. INDIVIDUAL is the default so every existing
/// round keeps its current behaviour.
enum ParticipationMode {
  INDIVIDUAL
  TEAM
  HYBRID
}

enum RoundType {
  MCQ
  CODING
  DEBUGGING
}

enum ChallengeType {
  MCQ
  CODING
  DEBUGGING
}

enum Difficulty {
  BEGINNER
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum Category {
  PROGRAMMING_FUNDAMENTALS
  ALGORITHMS
  DATA_STRUCTURES
  BACKEND_ENGINEERING
  FRONTEND_ENGINEERING
  APIS
  DATABASES_SQL
  DEBUGGING
  TESTING
  GIT_GITHUB
  DEVOPS
  CLOUD
  SECURITY
  SYSTEM_DESIGN
  SOFTWARE_ARCHITECTURE
  ENGINEERING_PRACTICES
  PERFORMANCE
}

enum Language {
  PYTHON
  JAVASCRIPT
  TYPESCRIPT
  JAVA
  CPP
  C
  GO
  CSHARP
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  SYSTEM_ERROR
}

enum SubmissionKind {
  RUN
  SUBMIT
}

enum ExecutionOutcome {
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
  INTERNAL_ERROR
}

enum ScoreSource {
  MCQ
  CODING
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  /// A one-time code handed to the browser after a Google sign-in.
  ///
  /// Exists because both auth cookies are SameSite=Strict, and a Strict cookie
  /// set on the response to a cross-site navigation — which is exactly what
  /// Google's redirect back to us is — is not stored by the browser. So the
  /// callback cannot sign anyone in. It issues one of these instead and
  /// redirects to a page on our own origin, which exchanges it same-site for
  /// the real cookies.
  OAUTH_EXCHANGE
}

/// Why a participant was notified.
///
/// The type drives the icon and the grouping in the UI, so it is an enum rather
/// than a free string: a typo in a caller would otherwise reach the bell as an
/// unstyled row. The three TEAM_REQUEST* members are not used yet — the team
/// join-request flow lands next — but they are declared here so that item needs
/// no second migration to alter this type.
enum NotificationType {
  ANNOUNCEMENT

  /// A competition opened for registration.
  ///
  /// The one notification that cannot be scoped to a competition's
  /// participants, because at the moment it is sent there are none — telling
  /// people they may now sign up is the entire point.
  COMPETITION_OPEN

  TEAM_JOINED
  ROUND_STARTED
  ROUND_ENDED
  GRADING_ALERT
  TEAM_JOIN_REQUEST
  TEAM_REQUEST_APPROVED
  TEAM_REQUEST_DECLINED
}

enum OAuthProvider {
  GOOGLE
}

model User {
  id    String @id @default(uuid()) @db.Uuid
  email String @unique

  /// Null for an account that has only ever signed in with a provider.
  ///
  /// Widening this is what makes Google sign-in possible without inventing a
  /// fake password nobody knows. Every read of it now has to handle null —
  /// notably `login`, which must still answer identically for "no password set"
  /// and "wrong password", or it becomes an oracle for which accounts are
  /// Google-only.
  passwordHash String?

  role          Role    @default(PARTICIPANT)
  emailVerified Boolean @default(false)
  isActive      Boolean @default(true)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile            Profile?
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  teamMemberships    TeamMember[]
  captainOf          Team[]                   @relation("TeamCaptain")
  participations     CompetitionParticipant[]
  submissions        Submission[]
  mcqAttempts        MCQAttempt[]
  scoreEvents        ScoreEvent[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  oauthAccounts      OAuthAccount[]

  @@index([role])
  @@map("users")
}

model Profile {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @unique @db.Uuid
  displayName String
  bio         String?
  country     String?
  githubUrl   String?
  avatarUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// Refresh tokens are stored hashed and grouped into families. Presenting a token
/// that has already been rotated revokes the entire family — this is how a stolen
/// token is detected rather than silently accepted.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  /// Set only when this token was retired by a normal rotation. It distinguishes
  /// "revoked because it was replaced" from "revoked by logout, or by the theft
  /// response" — only the former is eligible for the rotation grace window, so a
  /// genuinely revoked family can never be resurrected by a late replay.
  replacedByTokenHash String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @db.Uuid
  tokenHash String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model Competition {
  id          String           @id @default(uuid()) @db.Uuid
  slug        String           @unique
  name        String
  description String?
  state       CompetitionState @default(DRAFT)

  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?

  /// Team scores are the sum of member scores, so unequal team sizes would
  /// advantage larger teams. Capping the size is how an organizer keeps that
  /// fair; null means uncapped.
  maxTeamSize Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rounds       Round[]
  participants CompetitionParticipant[]
  teams        Team[]
  scoreEvents  ScoreEvent[]

  @@index([state])
  @@map("competitions")
}

model CompetitionParticipant {
  id            String   @id @default(uuid()) @db.Uuid
  competitionId String   @db.Uuid
  userId        String   @db.Uuid
  joinedAt      DateTime @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId])
  @@index([userId])
  @@map("competition_participants")
}

model Team {
  id            String @id @default(uuid()) @db.Uuid
  competitionId String @db.Uuid
  name          String

  /// Short human-readable join code. Unique platform-wide so a participant can
  /// join without also having to identify the competition.
  code String @unique

  avatarUrl String?

  /// Captaincy is a property of the team, not a platform role. A global
  /// TEAM_CAPTAIN role would make its holder captain of every team.
  captainId String @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competition Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  captain     User         @relation("TeamCaptain", fields: [captainId], references: [id])
  members     TeamMember[]
  scoreEvents ScoreEvent[]

  @@unique([competitionId, name])
  @@index([competitionId])
  @@map("teams")
}

model TeamMember {
  id     String @id @default(uuid()) @db.Uuid
  teamId String @db.Uuid
  userId String @db.Uuid

  /// Denormalised from the team so the database itself can guarantee one team
  /// per participant per competition. Enforcing that in service code alone would
  /// lose the race between two concurrent joins.
  competitionId String @db.Uuid

  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@unique([competitionId, userId])
  @@index([userId])
  @@map("team_members")
}

model Round {
  id            String     @id @default(uuid()) @db.Uuid
  competitionId String     @db.Uuid
  name          String
  description   String?
  type          RoundType
  state         RoundState @default(DRAFT)
  orderIndex    Int

  startsAt DateTime?
  endsAt   DateTime?

  /// Fraction of the final score this round contributes, e.g. 0.4 for 40%.
  weight Decimal @default(0) @db.Decimal(5, 4)

  allowedLanguages Language[] @default([])

  /// Defaults to ON_ROUND_END so existing rounds are unchanged by this migration.
  revealMode RevealMode @default(ON_ROUND_END)

  /// Defaults to INDIVIDUAL so existing rounds and their score data are unaffected.
  participationMode ParticipationMode @default(INDIVIDUAL)

  /// Null means unlimited, which is the behaviour every existing round has.
  attemptLimit Int?

  /// Points deducted per wrong MCQ. Applied by gradeMcq(), which clamps so a
  /// round can never take a participant below zero.
  negativeMarking Decimal @default(0) @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competition Competition      @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  challenges  RoundChallenge[]
  submissions Submission[]
  mcqAttempts MCQAttempt[]
  scoreEvents ScoreEvent[]

  @@unique([competitionId, orderIndex])
  @@index([competitionId, state])
  @@map("rounds")
}

model RoundChallenge {
  id          String @id @default(uuid()) @db.Uuid
  roundId     String @db.Uuid
  challengeId String @db.Uuid
  orderIndex  Int

  round     Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([roundId, challengeId])
  @@unique([roundId, orderIndex])
  @@map("round_challenges")
}

model Challenge {
  id          String        @id @default(uuid()) @db.Uuid
  type        ChallengeType
  title       String
  category    Category
  difficulty  Difficulty
  points      Int           @default(10)
  isPublished Boolean       @default(false)

  /// Bumped on every organizer edit. Submissions capture the version they were
  /// graded against so later edits cannot rewrite historical results.
  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mcqQuestion        MCQQuestion?
  codingChallenge    CodingChallenge?
  debuggingChallenge DebuggingChallenge?
  rounds             RoundChallenge[]
  submissions        Submission[]
  mcqAttempts        MCQAttempt[]

  @@index([type, isPublished])
  @@index([category, difficulty])
  @@map("challenges")
}

model MCQQuestion {
  id          String  @id @default(uuid()) @db.Uuid
  challengeId String  @unique @db.Uuid
  prompt      String
  codeSnippet String?
  explanation String?

  /// Optional diagram accompanying the question.
  imageUrl String?

  /// Free-form tags, separate from the fixed Category, for filtering a growing
  /// question bank.
  tags String[] @default([])

  /// Per-question time budget when a round wants one; null means the round's
  /// overall clock is the only limit.
  timeAllocationSeconds Int?

  challenge Challenge    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  options   MCQOption[]
  attempts  MCQAttempt[]

  @@map("mcq_questions")
}

model MCQOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @db.Uuid
  label      String
  text       String
  /// Never selected into a participant-facing response.
  isCorrect  Boolean @default(false)
  orderIndex Int

  question MCQQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, label])
  @@index([questionId])
  @@map("mcq_options")
}

model CodingChallenge {
  id          String @id @default(uuid()) @db.Uuid
  challengeId String @unique @db.Uuid

  statement    String
  constraints  String?
  inputFormat  String?
  outputFormat String?
  /// Starter code keyed by Language, e.g. { "PYTHON": "...", "JAVA": "..." }.
  /// A column per language stopped scaling at eight of them.
  starterCode  Json?

  cpuTimeLimit  Decimal @default(2.0) @db.Decimal(5, 2)
  wallTimeLimit Decimal @default(6.0) @db.Decimal(5, 2)
  memoryLimitKb Int     @default(128000)
  maxProcesses  Int     @default(30)
  maxFileSizeKb Int     @default(1024)

  challenge Challenge  @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  testCases TestCase[]

  @@map("coding_challenges")
}

/// Debugging is a distinct format, not a coding challenge with broken starter
/// code. What makes it debugging is the evidence: the participant sees the
/// symptom and the failing output, and has to work back to the cause.
model DebuggingChallenge {
  id          String @id @default(uuid()) @db.Uuid
  challengeId String @unique @db.Uuid

  /// The symptom, written the way someone would actually report it.
  bugReport String

  /// Verbatim failing output shown to the participant. This is the half that a
  /// "here is some broken code" challenge leaves out.
  failingTestOutput String

  /// Broken starting code keyed by Language.
  brokenCode Json

  /// Optional read-only supporting files, keyed by filename. Real debugging
  /// rarely happens in a single file.
  contextFiles Json?

  cpuTimeLimit  Decimal @default(2.0) @db.Decimal(5, 2)
  wallTimeLimit Decimal @default(6.0) @db.Decimal(5, 2)
  memoryLimitKb Int     @default(128000)
  maxProcesses  Int     @default(30)
  maxFileSizeKb Int     @default(1024)

  challenge Challenge  @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  testCases TestCase[]

  @@map("debugging_challenges")
}

model TestCase {
  id String @id @default(uuid()) @db.Uuid

  /// Exactly one of these is set. Sharing one model keeps the execution path
  /// identical for both formats rather than duplicating the judge pipeline.
  codingChallengeId    String? @db.Uuid
  debuggingChallengeId String? @db.Uuid
  /// Hidden cases are used for grading but their stdin/expected output must never
  /// reach a participant response, and they are excluded from /submissions/run.
  isHidden             Boolean @default(true)
  stdin                String
  expectedOutput       String
  weight               Int     @default(1)
  orderIndex           Int

  codingChallenge    CodingChallenge?    @relation(fields: [codingChallengeId], references: [id], onDelete: Cascade)
  debuggingChallenge DebuggingChallenge? @relation(fields: [debuggingChallengeId], references: [id], onDelete: Cascade)
  results            SubmissionResult[]

  @@unique([codingChallengeId, orderIndex])
  @@unique([debuggingChallengeId, orderIndex])
  @@index([codingChallengeId, isHidden])
  @@index([debuggingChallengeId, isHidden])
  @@map("test_cases")
}

model Submission {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @db.Uuid
  challengeId String @db.Uuid
  roundId     String @db.Uuid

  kind       SubmissionKind   @default(SUBMIT)
  language   Language
  sourceCode String
  status     SubmissionStatus @default(QUEUED)

  /// Immutable copy of the challenge as it existed at submit time.
  challengeVersion  Int
  challengeSnapshot Json

  passedTests Int?
  totalTests  Int?
  rawScore    Decimal? @db.Decimal(10, 4)

  compileOutput String?
  errorMessage  String?
  executionMs   Int?

  submittedAt DateTime  @default(now())
  gradedAt    DateTime?

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge  Challenge          @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  round      Round              @relation(fields: [roundId], references: [id], onDelete: Cascade)
  results    SubmissionResult[]
  scoreEvent ScoreEvent?

  @@index([userId, challengeId])
  @@index([status, submittedAt])
  @@index([roundId, userId])
  @@map("submissions")
}

model SubmissionResult {
  id           String           @id @default(uuid()) @db.Uuid
  submissionId String           @db.Uuid
  testCaseId   String           @db.Uuid
  passed       Boolean
  outcome      ExecutionOutcome
  timeMs       Int?
  memoryKb     Int?
  /// Populated only for visible test cases. Left null for hidden cases so a leak
  /// is impossible even if a selector is written carelessly.
  actualOutput String?
  stderr       String?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCase   TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([submissionId, testCaseId])
  @@index([submissionId])
  @@map("submission_results")
}

model MCQAttempt {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @db.Uuid
  challengeId String @db.Uuid
  questionId  String @db.Uuid
  roundId     String @db.Uuid

  selectedOptionId String  @db.Uuid
  isCorrect        Boolean
  rawScore         Decimal @db.Decimal(10, 4)

  /// Snapshotted at grade time so a later edit to the question or its options
  /// cannot change what this attempt was scored against.
  questionVersion Int
  correctOptionId String @db.Uuid

  answeredAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge  Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  question   MCQQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  round      Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  scoreEvent ScoreEvent?

  /// Scoped to the round, not just the question. A challenge library is shared
  /// across competitions, so the same question can legitimately appear in two
  /// different rounds — a global unique on (userId, questionId) made answering it
  /// once block it everywhere else forever. This matches the ScoreEvent
  /// constraint, which was already round-scoped.
  @@unique([userId, roundId, questionId])
  @@index([roundId, userId])
  @@map("mcq_attempts")
}

/// Raw score, weight and weighted score are stored separately so any final
/// standing can be reconstructed and audited from stored rows alone.
model ScoreEvent {
  id            String      @id @default(uuid()) @db.Uuid
  competitionId String      @db.Uuid
  roundId       String      @db.Uuid
  userId        String      @db.Uuid
  challengeId   String      @db.Uuid
  source        ScoreSource

  /// Set when the round is TEAM or HYBRID. Nullable so every existing row stays
  /// valid and INDIVIDUAL rounds are unaffected by this migration.
  teamId String? @db.Uuid

  rawScore      Decimal @db.Decimal(10, 4)
  maxRawScore   Decimal @db.Decimal(10, 4)
  roundWeight   Decimal @db.Decimal(5, 4)
  weightedScore Decimal @db.Decimal(10, 6)

  submissionId String? @unique @db.Uuid
  mcqAttemptId String? @unique @db.Uuid

  /// Milliseconds from round start to the moment this score was achieved.
  /// Drives the total-time tie-break.
  timeToSolveMs Int?

  createdAt DateTime @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  round       Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission  Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  mcqAttempt  MCQAttempt? @relation(fields: [mcqAttemptId], references: [id], onDelete: SetNull)

  team Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([userId, roundId, challengeId])
  @@index([competitionId, teamId])
  @@index([competitionId, userId])
  @@index([roundId])
  @@map("score_events")
}

model AuditLog {
  id         String  @id @default(uuid()) @db.Uuid
  actorId    String? @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// One delivered notification, per recipient.
///
/// Fanned out at write time rather than computed on read: a round starting is
/// one event but fifty rows, and storing them that way is what lets each
/// participant mark their own copy read without affecting anyone else. The
/// alternative — an events table plus a per-user read cursor — cannot express
/// "read the third one but not the second".
///
/// Shaped on AuditLog, which is the existing side table: `@db.Uuid` keys,
/// `metadata Json?` for the type-specific extras, plural snake_case `@@map`.
model Notification {
  id     String           @id @default(uuid()) @db.Uuid
  userId String           @db.Uuid
  type   NotificationType

  /// Rendered verbatim. Both are written by the server from server-side state,
  /// never echoed from a request body, so neither can carry a participant's
  /// text into another participant's bell.
  title String
  body  String

  /// Where clicking the row goes, as an app-relative path such as
  /// `/rounds/<id>`. Relative by constraint, not convention: the frontend
  /// refuses anything else, so a stored absolute URL cannot turn the bell into
  /// an open redirect.
  linkUrl String?

  /// Type-specific extras — `roundId`, `teamId`, `submissionId`. Deliberately
  /// not used for anything the UI must have: a row has to render correctly from
  /// `title`, `body` and `linkUrl` alone.
  metadata Json?

  /// Null until read. Nullable rather than a boolean so "when" is recoverable,
  /// and so the unread index below stays small as the table grows.
  readAt DateTime?

  /// Idempotency key for fan-out, scoped per user, null for anything that may
  /// legitimately repeat.
  ///
  /// A round that is paused and resumed transitions to LIVE twice, and an
  /// organizer correcting scores reopens and recloses a finished round. Without
  /// this, each of those sends every participant a duplicate. With it, the
  /// fan-out is `createMany({ skipDuplicates: true })` and the second attempt
  /// writes nothing. Postgres treats NULLs as distinct in a unique index, so
  /// announcements — which have no key and should never be collapsed — are
  /// unaffected.
  dedupeKey String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  /// Serves the unread badge: `userId = ? AND readAt IS NULL`.
  @@index([userId, readAt])
  /// Serves the list, which is always this user's newest first. The index above
  /// cannot do it as well — `readAt` sits between the two columns the query
  /// needs, so it could not be used to satisfy the sort.
  @@index([userId, createdAt])
  @@map("notifications")
}

/// A provider identity linked to an account.
///
/// Separate from User rather than a pair of columns on it, so one account can
/// hold several providers later without another migration, and so the unique
/// below can do the work that matters.
model OAuthAccount {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  provider OAuthProvider

  /// Google's `sub`. Stable for the lifetime of the Google account and never
  /// reused, which is why the link is keyed on this and not on the email — a
  /// Google user can change their email address, and someone else can later be
  /// issued the one they gave up.
  providerAccountId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One provider identity maps to exactly one account. This is the constraint
  /// that stops two of our users claiming the same Google identity.
  @@unique([provider, providerAccountId])
  /// One account holds at most one identity per provider.
  @@unique([userId, provider])
  @@map("oauth_accounts")
}
