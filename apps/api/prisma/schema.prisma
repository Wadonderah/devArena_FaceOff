generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PARTICIPANT
  ORGANIZER
  ADMIN
}

enum CompetitionState {
  DRAFT
  REGISTRATION
  LIVE
  COMPLETED
  ARCHIVED
}

enum RoundState {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  ARCHIVED
}

enum RoundType {
  MCQ
  CODING
}

enum ChallengeType {
  MCQ
  CODING
}

enum Difficulty {
  BEGINNER
  EASY
  MEDIUM
  HARD
}

enum Category {
  PROGRAMMING_FUNDAMENTALS
  ALGORITHMS
  DATA_STRUCTURES
  BACKEND_ENGINEERING
  DATABASES_SQL
  GIT_GITHUB
}

enum Language {
  PYTHON
  JAVASCRIPT
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  SYSTEM_ERROR
}

enum SubmissionKind {
  RUN
  SUBMIT
}

enum ExecutionOutcome {
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
  INTERNAL_ERROR
}

enum ScoreSource {
  MCQ
  CODING
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  passwordHash  String
  role          Role      @default(PARTICIPANT)
  emailVerified Boolean   @default(false)
  isActive      Boolean   @default(true)

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile            Profile?
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  participations     CompetitionParticipant[]
  submissions        Submission[]
  mcqAttempts        MCQAttempt[]
  scoreEvents        ScoreEvent[]
  auditLogs          AuditLog[]

  @@index([role])
  @@map("users")
}

model Profile {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @unique @db.Uuid
  displayName String
  bio         String?
  country     String?
  githubUrl   String?
  avatarUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// Refresh tokens are stored hashed and grouped into families. Presenting a token
/// that has already been rotated revokes the entire family — this is how a stolen
/// token is detected rather than silently accepted.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model VerificationToken {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String                @db.Uuid
  tokenHash String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model Competition {
  id          String           @id @default(uuid()) @db.Uuid
  slug        String           @unique
  name        String
  description String?
  state       CompetitionState @default(DRAFT)

  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rounds       Round[]
  participants CompetitionParticipant[]
  scoreEvents  ScoreEvent[]

  @@index([state])
  @@map("competitions")
}

model CompetitionParticipant {
  id            String   @id @default(uuid()) @db.Uuid
  competitionId String   @db.Uuid
  userId        String   @db.Uuid
  joinedAt      DateTime @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId])
  @@index([userId])
  @@map("competition_participants")
}

model Round {
  id            String     @id @default(uuid()) @db.Uuid
  competitionId String     @db.Uuid
  name          String
  description   String?
  type          RoundType
  state         RoundState @default(DRAFT)
  orderIndex    Int

  startsAt DateTime?
  endsAt   DateTime?

  /// Fraction of the final score this round contributes, e.g. 0.4 for 40%.
  weight Decimal @default(0) @db.Decimal(5, 4)

  allowedLanguages Language[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competition Competition      @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  challenges  RoundChallenge[]
  submissions Submission[]
  mcqAttempts MCQAttempt[]
  scoreEvents ScoreEvent[]

  @@unique([competitionId, orderIndex])
  @@index([competitionId, state])
  @@map("rounds")
}

model RoundChallenge {
  id          String @id @default(uuid()) @db.Uuid
  roundId     String @db.Uuid
  challengeId String @db.Uuid
  orderIndex  Int

  round     Round     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([roundId, challengeId])
  @@unique([roundId, orderIndex])
  @@map("round_challenges")
}

model Challenge {
  id          String        @id @default(uuid()) @db.Uuid
  type        ChallengeType
  title       String
  category    Category
  difficulty  Difficulty
  points      Int           @default(10)
  isPublished Boolean       @default(false)

  /// Bumped on every organizer edit. Submissions capture the version they were
  /// graded against so later edits cannot rewrite historical results.
  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mcqQuestion      MCQQuestion?
  codingChallenge  CodingChallenge?
  rounds           RoundChallenge[]
  submissions      Submission[]
  mcqAttempts      MCQAttempt[]

  @@index([type, isPublished])
  @@index([category, difficulty])
  @@map("challenges")
}

model MCQQuestion {
  id          String  @id @default(uuid()) @db.Uuid
  challengeId String  @unique @db.Uuid
  prompt      String
  codeSnippet String?
  explanation String?

  challenge Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  options   MCQOption[]
  attempts  MCQAttempt[]

  @@map("mcq_questions")
}

model MCQOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @db.Uuid
  label      String
  text       String
  /// Never selected into a participant-facing response.
  isCorrect  Boolean @default(false)
  orderIndex Int

  question MCQQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, label])
  @@index([questionId])
  @@map("mcq_options")
}

model CodingChallenge {
  id          String @id @default(uuid()) @db.Uuid
  challengeId String @unique @db.Uuid

  statement       String
  constraints     String?
  inputFormat     String?
  outputFormat    String?
  starterCodePy   String?
  starterCodeJs   String?

  cpuTimeLimit  Decimal @default(2.0) @db.Decimal(5, 2)
  wallTimeLimit Decimal @default(6.0) @db.Decimal(5, 2)
  memoryLimitKb Int     @default(128000)
  maxProcesses  Int     @default(30)
  maxFileSizeKb Int     @default(1024)

  challenge Challenge  @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  testCases TestCase[]

  @@map("coding_challenges")
}

model TestCase {
  id                String  @id @default(uuid()) @db.Uuid
  codingChallengeId String  @db.Uuid
  /// Hidden cases are used for grading but their stdin/expected output must never
  /// reach a participant response, and they are excluded from /submissions/run.
  isHidden          Boolean @default(true)
  stdin             String
  expectedOutput    String
  weight            Int     @default(1)
  orderIndex        Int

  codingChallenge CodingChallenge    @relation(fields: [codingChallengeId], references: [id], onDelete: Cascade)
  results         SubmissionResult[]

  @@unique([codingChallengeId, orderIndex])
  @@index([codingChallengeId, isHidden])
  @@map("test_cases")
}

model Submission {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @db.Uuid
  challengeId String @db.Uuid
  roundId     String @db.Uuid

  kind       SubmissionKind   @default(SUBMIT)
  language   Language
  sourceCode String
  status     SubmissionStatus @default(QUEUED)

  /// Immutable copy of the challenge as it existed at submit time.
  challengeVersion  Int
  challengeSnapshot Json

  passedTests Int?
  totalTests  Int?
  rawScore    Decimal? @db.Decimal(10, 4)

  compileOutput String?
  errorMessage  String?
  executionMs   Int?

  submittedAt DateTime  @default(now())
  gradedAt    DateTime?

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge          @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  round     Round              @relation(fields: [roundId], references: [id], onDelete: Cascade)
  results   SubmissionResult[]
  scoreEvent ScoreEvent?

  @@index([userId, challengeId])
  @@index([status, submittedAt])
  @@index([roundId, userId])
  @@map("submissions")
}

model SubmissionResult {
  id           String           @id @default(uuid()) @db.Uuid
  submissionId String           @db.Uuid
  testCaseId   String           @db.Uuid
  passed       Boolean
  outcome      ExecutionOutcome
  timeMs       Int?
  memoryKb     Int?
  /// Populated only for visible test cases. Left null for hidden cases so a leak
  /// is impossible even if a selector is written carelessly.
  actualOutput String?
  stderr       String?

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCase   TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([submissionId, testCaseId])
  @@index([submissionId])
  @@map("submission_results")
}

model MCQAttempt {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @db.Uuid
  challengeId String @db.Uuid
  questionId  String @db.Uuid
  roundId     String @db.Uuid

  selectedOptionId String  @db.Uuid
  isCorrect        Boolean
  rawScore         Decimal @db.Decimal(10, 4)

  /// Snapshotted at grade time so a later edit to the question or its options
  /// cannot change what this attempt was scored against.
  questionVersion  Int
  correctOptionId  String @db.Uuid

  answeredAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge  Challenge   @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  question   MCQQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  round      Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  scoreEvent ScoreEvent?

  @@unique([userId, questionId])
  @@index([roundId, userId])
  @@map("mcq_attempts")
}

/// Raw score, weight and weighted score are stored separately so any final
/// standing can be reconstructed and audited from stored rows alone.
model ScoreEvent {
  id            String      @id @default(uuid()) @db.Uuid
  competitionId String      @db.Uuid
  roundId       String      @db.Uuid
  userId        String      @db.Uuid
  challengeId   String      @db.Uuid
  source        ScoreSource

  rawScore      Decimal @db.Decimal(10, 4)
  maxRawScore   Decimal @db.Decimal(10, 4)
  roundWeight   Decimal @db.Decimal(5, 4)
  weightedScore Decimal @db.Decimal(10, 6)

  submissionId String? @unique @db.Uuid
  mcqAttemptId String? @unique @db.Uuid

  /// Milliseconds from round start to the moment this score was achieved.
  /// Drives the total-time tie-break.
  timeToSolveMs Int?

  createdAt DateTime @default(now())

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  round       Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission  Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  mcqAttempt  MCQAttempt? @relation(fields: [mcqAttemptId], references: [id], onDelete: SetNull)

  @@unique([userId, roundId, challengeId])
  @@index([competitionId, userId])
  @@index([roundId])
  @@map("score_events")
}

model AuditLog {
  id         String  @id @default(uuid()) @db.Uuid
  actorId    String? @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
